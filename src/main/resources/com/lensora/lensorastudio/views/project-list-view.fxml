<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.lensora.lensorastudio.controller.ProjectListController"
    spacing="5" VBox.vgrow="ALWAYS">
    <padding>
        <Insets top="5" right="5" bottom="5" left="5"/>
    </padding>

    <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
        <tabs>
            <Tab text="Projects">
                <content>
                    <VBox spacing="0">
                        <HBox alignment="CENTER_LEFT" spacing="6" style="-fx-padding: 6 8 4 8;">
                            <Label fx:id="lblProjectCount" text="0 projects"/>
                            <Pane HBox.hgrow="ALWAYS"/>
                            <ComboBox fx:id="cmbStatusFilter" promptText="All Statuses" prefWidth="130"/>
                        </HBox>
                        <TableView fx:id="projectTable" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colProjectNumber" prefWidth="120" text="Project No"/>
                                <TableColumn fx:id="colClientName" prefWidth="180" text="Client"/>
                                <TableColumn fx:id="colStatus" prefWidth="100" text="Status"/>
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                        </TableView>
                    </VBox>
                </content>
            </Tab>

            <Tab text="Reminders">
                <content>
                    <VBox spacing="0">
                        <HBox alignment="CENTER_LEFT" spacing="6" style="-fx-padding: 6 8 4 8;">
                            <Label fx:id="lblReminderCount" text="0 reminders"/>
                            <Pane HBox.hgrow="ALWAYS"/>
                            <CheckBox fx:id="chkShowCompleted" text="Show completed"/>
                        </HBox>
                        <TableView fx:id="reminderTable" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colReminderDate" text="Date"/>
                                <TableColumn fx:id="colReminderProject" text="Project"/>
                                <TableColumn fx:id="colReminderTitle" text="Title"/>
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                            <placeholder>
                                <Label text="No upcoming reminders."/>
                            </placeholder>
                        </TableView>
                    </VBox>
                </content>
            </Tab>
        </tabs>
    </TabPane>
</VBox>