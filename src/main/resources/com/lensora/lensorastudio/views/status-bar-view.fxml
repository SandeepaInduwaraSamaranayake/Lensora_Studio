<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox xmlns="http://javafx.com/javafx/17"
    xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.lensora.lensorastudio.controller.StatusBarController" spacing="0" alignment="CENTER_LEFT" style="-fx-padding: 3 5 3 5;">
    <Label fx:id="lblStatusText" text="Ready"/>
    <Separator orientation="VERTICAL" style="-fx-padding: 0 10;"/>
    <Label fx:id="lblStatusProjects" text="Projects: 0"/>
    <Separator orientation="VERTICAL" style="-fx-padding: 0 10;"/>
    <Label fx:id="lblStatusReminders" text="Reminders: 0"/>
    <Pane HBox.hgrow="ALWAYS"/>
    <HBox fx:id="progressContainer" spacing="6" alignment="CENTER_LEFT" visible="false" managed="false">
        <ProgressBar fx:id="progressBar" style="-fx-min-width: 18em; -fx-pref-width: 18em; -fx-max-width: 18em;" progress="0"/>
        <Label fx:id="progressLabel" text="0%" style="-fx-min-width: 5em; -fx-alignment: center-left;"/>
        <Label fx:id="progressSpeedLabel" text="0 KB/s" style="-fx-min-width: 5em; -fx-alignment: center-left;"/>
        <Label fx:id="progressEtaLabel" text="ETA: --" style="-fx-min-width: 8em; -fx-alignment: center-left;"/>
    </HBox>
    <Separator orientation="VERTICAL" style="-fx-padding: 0 10;"/>
    <Label fx:id="lblStatusPath" text="" style="-fx-cursor: hand;"/>
</HBox>