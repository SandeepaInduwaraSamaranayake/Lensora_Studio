<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
    xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.lensora.lensorastudio.feature.backup.ui.BackupRestoreCenterController">

    <center>
        <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE" prefWidth="1000" prefHeight="600">

            <!-- ====================== Backup tab ====================== -->
            <Tab text="Backup">
                <content>
                    <VBox spacing="14">
                        <padding>
                            <Insets top="16" right="16" bottom="16" left="16"/>
                        </padding>

                        <Label text="Create a Backup" style="-fx-font-weight: bold;"/>
                        <Label text="Choose a project and destination to create a self-contained .lsbak archive." wrapText="true" style="-fx-opacity: 0.75;"/>

                        <!-- Set GridPane to grow vertically inside the VBox -->
                        <GridPane hgap="12" vgap="10" VBox.vgrow="ALWAYS">
                            <columnConstraints>
                                <ColumnConstraints minWidth="120" prefWidth="130"/>
                                <ColumnConstraints hgrow="ALWAYS"/>
                            </columnConstraints>
                            <rowConstraints>
                                <!-- Row 0 (ListView) takes all vertical expansion space -->
                                <RowConstraints vgrow="ALWAYS"/>
                                <RowConstraints vgrow="NEVER"/>
                            </rowConstraints>

                            <Label text="Projects" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                            <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <CheckBox fx:id="selectAllProjectsCheckBox" text="Select All"/>
                                <!-- Allow ListView to expand vertically -->
                                <ListView fx:id="backupProjectListView" VBox.vgrow="ALWAYS" maxHeight="Infinity"/>
                            </VBox>

                            <Label text="Destination" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                            <HBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                <TextField fx:id="backupDestinationField" editable="false" promptText="Select a folder to save backup(s) into…" HBox.hgrow="ALWAYS"/>
                                <Button fx:id="btnBrowseBackupDestination" text="Browse…"/>
                            </HBox>

                            <rowConstraints>
                                <RowConstraints/>
                                <RowConstraints/>
                            </rowConstraints>
                        </GridPane>

                        <Separator/>

                        <VBox fx:id="backupProgressBox" spacing="6" visible="false" managed="false">
                            <Label fx:id="backupStatusLabel" text=""/>
                            <ProgressBar fx:id="backupProgressBar" maxWidth="Infinity" progress="0"/>
                        </VBox>

                        <Region VBox.vgrow="ALWAYS"/>

                        <HBox alignment="CENTER_RIGHT" spacing="10">
                            <Button fx:id="btnStartBackup" text="Create Backup" defaultButton="true"/>
                        </HBox>
                    </VBox>
                </content>
            </Tab>

            <!-- ====================== Restore tab ====================== -->
            <Tab text="Restore">
                <content>
                    <VBox spacing="14">
                        <padding>
                            <Insets top="16" right="16" bottom="16" left="16"/>
                        </padding>

                        <Label text="Restore from Backup" style="-fx-font-weight: bold;"/>
                        <Label text="Select one or more .lsbak files. Each will be restored into its own subfolder under the chosen destination." wrapText="true" style="-fx-opacity: 0.75;"/>

                        <!-- Allow ListView to expand vertically -->
                        <ListView fx:id="restoreFileListView" VBox.vgrow="ALWAYS" maxHeight="Infinity">
                            <contextMenu>
                                <ContextMenu>
                                    <items>
                                        <MenuItem fx:id="ctxRestoreVerifySelected" text="Verify Selected"/>
                                        <MenuItem fx:id="ctxRestoreRemove" text="Remove from Queue"/>
                                        <SeparatorMenuItem/>
                                        <MenuItem fx:id="ctxRestoreStart" text="Restore Now"/>
                                    </items>
                                </ContextMenu>
                            </contextMenu>
                        </ListView>

                        <HBox spacing="6">
                            <Button fx:id="btnAddRestoreFiles" text="Add Files…"/>
                            <Button fx:id="btnRemoveRestoreFile" text="Remove Selected"/>
                            <Button fx:id="btnClearRestoreFiles" text="Clear All"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button fx:id="btnVerifySelected" text="Verify Selected File"/>
                            <Button fx:id="btnVerifyAll" text="Verify All"/>
                        </HBox>

                        <VBox fx:id="verifyProgressBox" spacing="6" visible="false" managed="false">
                            <Label fx:id="verifyStatusLabel" text=""/>
                            <ProgressBar fx:id="verifyProgressBar" maxWidth="Infinity" progress="0"/>
                        </VBox>

                        <GridPane hgap="12" vgap="10">
                            <columnConstraints>
                                <ColumnConstraints minWidth="120" prefWidth="130"/>
                                <ColumnConstraints hgrow="ALWAYS"/>
                            </columnConstraints>

                            <Label text="Restore To" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                            <HBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <TextField fx:id="restoreDestinationField" editable="false" promptText="Select a parent destination folder…" HBox.hgrow="ALWAYS"/>
                                <Button fx:id="btnBrowseRestoreDestination" text="Browse…"/>
                            </HBox>

                            <rowConstraints>
                                <RowConstraints/>
                            </rowConstraints>
                        </GridPane>

                        <Separator/>

                        <VBox fx:id="restoreProgressBox" spacing="6" visible="false" managed="false">
                            <Label fx:id="restoreStatusLabel" text=""/>
                            <ProgressBar fx:id="restoreProgressBar" maxWidth="Infinity" progress="0"/>
                        </VBox>

                        <Region VBox.vgrow="ALWAYS"/>

                        <HBox alignment="CENTER_RIGHT" spacing="10">
                            <Button fx:id="btnStartRestore" text="Restore" defaultButton="true"/>
                        </HBox>
                    </VBox>
                </content>
            </Tab>
            <!-- ====================== Schedule tab ====================== -->
            <Tab text="Schedule Backups">
                <content>
                    <VBox spacing="10">
                        <padding>
                            <Insets top="16" right="16" bottom="16" left="16"/>
                        </padding>

                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="Backup Schedules" style="-fx-font-weight: bold;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button fx:id="btnRefresh" text="Refresh"/>
                            <Button fx:id="btnNewSchedule" text="New Schedule…"/>
                        </HBox>

                        <TableView fx:id="scheduleTableView" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colScheduleName" text="Name" prefWidth="160"/>
                                <TableColumn fx:id="colScheduleStatus" text="Status" prefWidth="100"/>
                                <TableColumn fx:id="colScheduleScope" text="Projects" prefWidth="120"/>
                                <TableColumn fx:id="colScheduleFrequency" text="Frequency" prefWidth="160"/>
                                <TableColumn fx:id="colScheduleDestination" text="Destination" prefWidth="200"/>
                                <TableColumn fx:id="colScheduleNextRun" text="Next Run" prefWidth="140"/>
                                <TableColumn fx:id="colScheduleEnabled" text="Enabled" prefWidth="70"/>
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                            <placeholder>
                                <Label text="No backup schedules configured yet."/>
                            </placeholder>
                            <contextMenu>
                                <ContextMenu>
                                    <items>
                                        <MenuItem fx:id="ctxScheduleRunNow" text="Run Now"/>
                                        <MenuItem fx:id="ctxScheduleEdit" text="Edit…"/>
                                        <MenuItem fx:id="ctxScheduleToggleEnabled" text="Enable/Disable"/>
                                        <SeparatorMenuItem/>
                                        <MenuItem fx:id="ctxScheduleDelete" text="Delete"/>
                                    </items>
                                </ContextMenu>
                            </contextMenu>
                        </TableView>

                        <HBox alignment="CENTER_RIGHT" spacing="10">
                            <Button fx:id="btnRunScheduleNow" text="Run Now"/>
                            <Button fx:id="btnEditSchedule" text="Edit…"/>
                            <Button fx:id="btnDeleteSchedule" text="Delete"/>
                        </HBox>
                    </VBox>
                </content>
            </Tab>

            <!-- ====================== History tab ====================== -->
            <Tab text="History">
                <content>
                    <VBox spacing="10">
                        <padding>
                            <Insets top="16" right="16" bottom="16" left="16"/>
                        </padding>

                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="Backup History" style="-fx-font-weight: bold;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button fx:id="btnRefreshHistory" text="Refresh"/>
                        </HBox>

                        <TableView fx:id="historyTableView" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colHistoryDate" text="Date" prefWidth="130"/>
                                <TableColumn fx:id="colHistoryProject" text="Project" prefWidth="160"/>
                                <TableColumn fx:id="colHistorySource" text="Source" prefWidth="140"/>
                                <TableColumn fx:id="colHistorySize" text="Size" prefWidth="80"/>
                                <TableColumn fx:id="colHistoryStatus" text="Status" prefWidth="90"/>
                                <TableColumn fx:id="colHistoryVerified" text="Verified" prefWidth="70"/>
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                            <placeholder>
                                <Label text="No backups recorded yet."/>
                            </placeholder>
                            <contextMenu>
                                <ContextMenu>
                                    <items>
                                        <MenuItem fx:id="ctxHistoryOpenFolder" text="Open Containing Folder"/>
                                        <MenuItem fx:id="ctxHistoryVerify" text="Verify"/>
                                        <MenuItem fx:id="ctxHistoryRestore" text="Restore"/>
                                        <SeparatorMenuItem/>
                                        <MenuItem fx:id="ctxHistoryDelete" text="Remove from History"/>
                                    </items>
                                </ContextMenu>
                            </contextMenu>
                        </TableView>

                        <HBox alignment="CENTER_RIGHT" spacing="10">
                            <Button fx:id="btnOpenHistoryFolder" text="Open Containing Folder"/>
                            <Button fx:id="btnVerifyHistoryItem" text="Verify"/>
                            <Button fx:id="btnRestoreHistoryItem" text="Restore"/>
                            <Button fx:id="btnDeleteHistoryItem" text="Remove from History"/>
                        </HBox>
                    </VBox>
                </content>
            </Tab>
        </TabPane>
    </center>
</BorderPane>