<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<SplitPane fx:id="fileSplitPane" dividerPositions="0.2"
    xmlns="http://javafx.com/javafx/17"
    xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.lensora.lensorastudio.controller.FileExplorerController">

    <VBox spacing="0">
        <HBox alignment="CENTER_LEFT" spacing="6" style="-fx-padding: 6 8;">
            <Button fx:id="btnFolderBack" text="⬅"/>
            <Button fx:id="btnFolderForward" text="➡"/>
            <FontIcon iconLiteral="fas-folder" iconSize="10"/>
            <Label fx:id="lblFolderHeader" text="Folders [" style="-fx-font-weight: bold;"/>
            <HBox fx:id="breadcrumbContainer" spacing="2" alignment="CENTER_LEFT" style="-fx-font-weight: bold;"/>
            <Label text="]" style="-fx-font-weight: bold;"/>
        </HBox>
        <Separator/>
        <TreeView fx:id="folderTree" VBox.vgrow="ALWAYS" showRoot="false"/>
    </VBox>

    <VBox spacing="0">
        <HBox alignment="CENTER_LEFT" spacing="6" style="-fx-padding: 6 8;">
            <FontIcon iconLiteral="fas-images" iconSize="10"/>
            <Label fx:id="lblCurrentFolder" text="Files" style="-fx-font-weight: bold;"/>
            <Label fx:id="lblFileCount" text="" style="-fx-padding: 0 0 0 8;"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <TextField fx:id="fileSearchField" promptText="Search (ALT + F)" style="-fx-padding: 2 6;"/>
            <Separator orientation="VERTICAL"/>
            <HBox spacing="2">
                <ToggleButton fx:id="btnDetails" selected="true">
                    <graphic>
                        <FontIcon iconLiteral="fas-table" iconSize="10"/>
                    </graphic>
                    <tooltip>
                        <Tooltip text="Details View"/>
                    </tooltip>
                </ToggleButton>
                <ToggleButton fx:id="btnList">
                    <graphic>
                        <FontIcon iconLiteral="fas-list" iconSize="10"/>
                    </graphic>
                    <tooltip>
                        <Tooltip text="List View"/>
                    </tooltip>
                </ToggleButton>
                <ToggleButton fx:id="btnIcons">
                    <graphic>
                        <FontIcon iconLiteral="fas-th-large" iconSize="10"/>
                    </graphic>
                    <tooltip>
                        <Tooltip text="Icons View"/>
                    </tooltip>
                </ToggleButton>
                <ToggleButton fx:id="btnThumbnails">
                    <graphic>
                        <FontIcon iconLiteral="fas-images" iconSize="10"/>
                    </graphic>
                    <tooltip>
                        <Tooltip text="Thumbnails View"/>
                    </tooltip>
                </ToggleButton>
            </HBox>
        </HBox>
        <Separator/>
        <StackPane VBox.vgrow="ALWAYS">
            <TableView fx:id="fileTable" visible="true" managed="true" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colFileName" text="Name" prefWidth="240"/>
                    <TableColumn fx:id="colFileType" text="Type" prefWidth="60"/>
                    <TableColumn fx:id="colFileSize" text="Size" prefWidth="80"/>
                    <TableColumn fx:id="colFileDimensions" text="Dimensions" prefWidth="100"/>
                    <TableColumn fx:id="colFileModified" text="Modified" prefWidth="130"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <placeholder>
                    <Label text="Select a folder to view files."/>
                </placeholder>
                <contextMenu>
                    <ContextMenu>
                        <items>
                            <MenuItem fx:id="ctxFileOpen" text="Open"/>
                            <Menu     fx:id="ctxOpenWithMenu" text="Open With"/>
                            <MenuItem fx:id="ctxOpenInAnotherWindow" text="Open in Another Window"/>
                            <SeparatorMenuItem/>
                            <MenuItem fx:id="ctxFileRename" text="Rename…"/>
                            <MenuItem fx:id="ctxFileCopy" text="Copy"/>
                            <MenuItem fx:id="ctxFileCut" text="Cut"/>
                            <MenuItem fx:id="ctxFileMove" text="Move to…"/>
                            <SeparatorMenuItem/>
                            <MenuItem fx:id="ctxFileDelete" text="Delete"/>
                            <SeparatorMenuItem/>
                            <MenuItem fx:id="ctxFileShowInExplorer" text="Show in Explorer"/>
                            <MenuItem fx:id="ctxFileProperties" text="Metadata"/>
                        </items>
                    </ContextMenu>
                </contextMenu>
            </TableView>
            <ListView fx:id="fileListView" visible="false" managed="false" VBox.vgrow="ALWAYS"/>
            <ScrollPane fx:id="iconScrollPane" visible="false" managed="false" fitToWidth="true" VBox.vgrow="ALWAYS">
                <FlowPane fx:id="iconFlowPane" hgap="10" vgap="10" style="-fx-padding: 10;"/>
            </ScrollPane>
        </StackPane>
    </VBox>
</SplitPane>